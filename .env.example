# ===== 구글 시트 =====
# Google Cloud 서비스 계정 JSON 파일 경로 (config/google_service_account.json 로 저장)
GOOGLE_SERVICE_ACCOUNT_JSON=config/google_service_account.json
GOOGLE_SHEET_NAME=소리튠_과제체킹_명단

# ===== boot.soritune.com 조장/부조장 현황판 =====
# 보통 바꿀 필요 없음 (기본값 그대로 사용)
DASHBOARD_BASE_URL=https://boot.soritune.com

# ===== 하멈말 업로드 폼 보호용 비밀번호 =====
UPLOAD_PASSWORD=원하는_비밀번호로_변경

# ===== 하멈말 테스트용 (평소엔 비워두기) =====
# 1/true 로 설정하면 "지금 하멈말 기간이 아니에요" 차단을 건너뛰고
# 업로드 폼을 바로 테스트해볼 수 있음 (진행 중인 기수는 여전히 있어야 함)
HAMUMMAL_TEST_MODE=

# ===== 앱 자체 설정 =====
FLASK_SECRET_KEY=아무렇게나_긴_랜덤문자열
TIMEZONE=Asia/Seoul
